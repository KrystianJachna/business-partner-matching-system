@startuml
title Wywołanie API dopasowania - diagram sekwencji
!pragma layout smetana

actor User
participant "MatchingController" as controller
participant "BusinessMatchingService" as service
participant "Need/Offer repositories" as repositories
participant "Ranking generators" as rankings
participant "MatchingAlgorithm" as algorithm
participant "MatchingScoreCalculator" as calculator
participant "ScoringWeightsProvider" as weights

User -> controller : POST /api/matching
controller -> service : match()
service -> repositories : findAllByActiveTrue()
repositories --> service : needs and offers
service -> rankings : generate rankings
rankings --> service : participant preferences
service -> algorithm : match(MatchingProblem)
algorithm --> service : PopularMatchingResult
service --> controller : matching result
controller -> calculator : calculate scores
calculator -> weights : forNeed / forOffer
weights --> calculator : ScoringWeights
calculator --> controller : criterion and total scores
controller --> User : MatchingResponse
@enduml
