@startuml
title Business Partner Matching System - backend architecture

!pragma layout smetana

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "REST API" {
    class BusinessNeedController <<RestController>>
    class BusinessOfferController <<RestController>>
    class CompanyController <<RestController>>
    class IndustryController <<RestController>>
    class SpecializationController <<RestController>>
    class MatchingController <<RestController>>
}

package "Application services" {
    class BusinessNeedService <<Service>>
    class BusinessOfferService <<Service>>
    class CompanyService <<Service>>
    class IndustryService <<Service>>
    class SpecializationService <<Service>>
    class SpecializationResolver <<Service>>
    class BusinessMatchingService <<Service>>
}

package "Persistence" {
    interface BusinessNeedRepository <<JpaRepository>>
    interface BusinessOfferRepository <<JpaRepository>>
    interface CompanyRepository <<JpaRepository>>
    interface IndustryRepository <<JpaRepository>>
    interface SpecializationRepository <<JpaRepository>>

    class BusinessNeed <<Entity>>
    class BusinessOffer <<Entity>>
    class Company <<Entity>>
    class Industry <<Entity>>
    class Specialization <<Entity>>
}

package "Matching" {
    interface MatchingAlgorithm<L,R>
    class ManyToManyGaleShapleyAlgorithm <<Component>>
    class MatchingProblem
    class PopularMatchingResult
    class Match
    class ParticipantPreferenceSet
    class ParticipantPreferences
    class ParticipantCapacitySet
    class ParticipantPreferencesGenerator
    class OffersForNeedRankingGenerator
    class NeedsForOfferRankingGenerator

    class CompatibilityChecker
    interface CompatibilityRule
    class ActiveEntitiesRule
    class BudgetOverlapRule
    class CommonSpecializationRule
    class CooperationTypeRule
    class DateRangeOverlapRule
    class DifferentCompanyRule
    class DistanceRule
    class PartnerExperienceRule

    class MatchingScoreCalculator
    interface CriterionScoreCalculator
    class BudgetScoreCalculator
    class DateScoreCalculator
    class DistanceScoreCalculator
    class ExperienceScoreCalculator
    class SpecializationScoreCalculator
    enum MatchingCriterion

    interface ScoringWeightsProvider
    class DefaultScoringWeightsProvider
    class AHPScoringWeightsProvider
    class AHPComparisonMatrixFactory
    class ScoringWeights
}

package "Shared infrastructure" {
    class JacksonConfig <<Configuration>>
    class GlobalExceptionHandler <<ControllerAdvice>>
    class HaversineDistanceCalculator
    interface DistanceCalculator
    class FixedRateMoneyConverter
    interface MoneyConverter
}

' REST -> application services
BusinessNeedController --> BusinessNeedService
BusinessOfferController --> BusinessOfferService
CompanyController --> CompanyService
IndustryController --> IndustryService
SpecializationController --> SpecializationService
MatchingController --> BusinessMatchingService
MatchingController --> MatchingScoreCalculator
MatchingController --> ScoringWeightsProvider

' CRUD services -> persistence
BusinessNeedService --> BusinessNeedRepository
BusinessNeedService --> SpecializationResolver
BusinessNeedService --> JacksonConfig
BusinessOfferService --> BusinessOfferRepository
BusinessOfferService --> SpecializationResolver
BusinessOfferService --> JacksonConfig
CompanyService --> CompanyRepository
IndustryService --> IndustryRepository
SpecializationService --> SpecializationRepository
SpecializationResolver --> SpecializationRepository

' Entity relationships
BusinessNeed "*" --> "1" Company
BusinessOffer "*" --> "1" Company
BusinessNeed "*" --> "*" Specialization
BusinessOffer "*" --> "*" Specialization
Specialization "*" --> "1" Industry

' Matching flow
BusinessMatchingService --> BusinessNeedRepository
BusinessMatchingService --> BusinessOfferRepository
BusinessMatchingService --> OffersForNeedRankingGenerator
BusinessMatchingService --> NeedsForOfferRankingGenerator
BusinessMatchingService --> ParticipantPreferencesGenerator
BusinessMatchingService --> MatchingAlgorithm
BusinessMatchingService --> MatchingProblem
MatchingProblem o-- ParticipantPreferenceSet
MatchingProblem o-- ParticipantCapacitySet
ParticipantPreferenceSet o-- ParticipantPreferences
MatchingAlgorithm <|.. ManyToManyGaleShapleyAlgorithm
ManyToManyGaleShapleyAlgorithm --> PopularMatchingResult
PopularMatchingResult o-- Match

' Compatibility and scoring
MatchingScoreCalculator --> CompatibilityChecker
CompatibilityChecker --> CompatibilityRule
CompatibilityRule <|.. ActiveEntitiesRule
CompatibilityRule <|.. BudgetOverlapRule
CompatibilityRule <|.. CommonSpecializationRule
CompatibilityRule <|.. CooperationTypeRule
CompatibilityRule <|.. DateRangeOverlapRule
CompatibilityRule <|.. DifferentCompanyRule
CompatibilityRule <|.. DistanceRule
CompatibilityRule <|.. PartnerExperienceRule
CompatibilityChecker --> DistanceCalculator
DistanceCalculator <|.. HaversineDistanceCalculator
MatchingScoreCalculator --> CriterionScoreCalculator
CriterionScoreCalculator <|.. BudgetScoreCalculator
CriterionScoreCalculator <|.. DateScoreCalculator
CriterionScoreCalculator <|.. DistanceScoreCalculator
CriterionScoreCalculator <|.. ExperienceScoreCalculator
CriterionScoreCalculator <|.. SpecializationScoreCalculator
CriterionScoreCalculator --> MatchingCriterion
MatchingScoreCalculator --> ScoringWeightsProvider
ScoringWeightsProvider <|.. DefaultScoringWeightsProvider
ScoringWeightsProvider <|.. AHPScoringWeightsProvider
AHPScoringWeightsProvider --> AHPComparisonMatrixFactory
AHPScoringWeightsProvider --> DefaultScoringWeightsProvider : fallback
AHPScoringWeightsProvider --> ScoringWeights

' AHP data flow
BusinessNeedService ..> AHPComparisonMatrixFactory : validates comparisons
BusinessOfferService ..> AHPComparisonMatrixFactory : validates comparisons
BusinessNeed ..> ScoringWeightsProvider : ahpComparisonsJson
BusinessOffer ..> ScoringWeightsProvider : ahpComparisonsJson

note right of AHPScoringWeightsProvider
  If AHP preferences are missing or invalid,
  default scoring weights are used.
end note

note bottom of MatchingController
  POST /api/matching
end note

@enduml
